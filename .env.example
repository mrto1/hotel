# Kopieren nach .env.local und ausfüllen. Nie committen.
DATABASE_URL=postgres://postgres@localhost:5432/hotel_dev
APP_BASE_URL=http://localhost:3000

# fake = Zahlung wird sofort bestätigt (Entwicklung, M1). stripe = Stripe Connect (M2).
PAYMENT_PROVIDER=fake

# Stripe (Testmodus: sk_test_...). Webhook-Endpoint für "Connected accounts" anlegen:
#   <APP_BASE_URL>/api/webhooks/stripe  →  Signing secret hier eintragen
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_CONNECT=

# Channex (M3)
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=

# E-Mail. Ohne Token werden E-Mails nur in der Konsole ausgegeben.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=buchung@example.ch
PLATFORM_ALERT_EMAIL=

# Mindestens 32 zufällige Zeichen: openssl rand -base64 32
AUTH_SECRET=

# Fotos/Unterschriften (später, S3-kompatibel, Region CH/EU)
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=
